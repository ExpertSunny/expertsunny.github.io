---
// Import Google fonts and other assets
const { pageTitle } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Preetish Chandra's Cybersecurity Portfolio - Showcasing red teaming projects, bug bounty reports, and secure app builds." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle ? `${pageTitle} | Preetish Chandra` : 'Preetish Chandra | Cybersecurity Specialist'}</title>
  </head>  <body class="bg-slate-900 text-slate-100 font-sans min-h-screen flex flex-col">
    <header class="border-b border-slate-800 sticky top-0 z-50 bg-slate-900/95 backdrop-blur-sm">
      <div class="container mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-accent-400 hover:text-accent-300 transition">
          Preetish Chandra
        </a>        <nav>
          <ul class="flex gap-6">
            <li><a href="/" class="text-slate-300 hover:text-accent-400 transition">Home</a></li>
            <li><a href="/about" class="text-slate-300 hover:text-accent-400 transition">About</a></li>
          </ul>
        </nav>
      </div>
    </header>
    
    <main class="flex-grow">
      <slot />
    </main>      <footer class="bg-slate-950 py-8 mt-12 border-t border-slate-800">
      <div class="container mx-auto px-4">
        <div class="flex justify-center items-center">
          <div>
            <p class="text-slate-400">© 2025 Preetish Chandra. All rights reserved.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
