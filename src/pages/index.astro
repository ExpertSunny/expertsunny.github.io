---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Portfolio">
  <!-- Hero Section -->
  <section class="py-20 md:py-28 relative overflow-hidden">
    <!-- Animated Mesh Background (Hero Section Only) -->
    <div class="absolute inset-0 -z-10 overflow-hidden">
      <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <filter id="glow">
            <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
            <feMerge> 
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        
        <!-- Removed mesh lines for cleaner particle effect -->
        
        <!-- Animated Nodes -->
        <g class="mesh-nodes" fill="rgba(59, 130, 246, 0.4)" filter="url(#glow)">
          <circle class="mesh-node-1" cx="15%" cy="25%" r="3"/>
          <circle class="mesh-node-2" cx="35%" cy="45%" r="2"/>
          <circle class="mesh-node-3" cx="65%" cy="35%" r="2.5"/>
          <circle class="mesh-node-4" cx="85%" cy="65%" r="2"/>
          <circle class="mesh-node-5" cx="25%" cy="75%" r="3"/>
          <circle class="mesh-node-6" cx="75%" cy="25%" r="2"/>
          <circle class="mesh-node-7" cx="45%" cy="85%" r="2.5"/>
          <circle class="mesh-node-8" cx="90%" cy="15%" r="2"/>
        </g>
        
        <!-- Connecting Lines Between Nodes - Removed for cleaner particle effect -->

        <!-- Dynamic Particle Connections -->
        <g class="particle-connections" stroke="rgba(59, 130, 246, 0.1)" stroke-width="0.3" fill="none">
          <!-- Particle 1 connections -->
          <line class="particle-connect-1a" x1="10%" y1="20%" x2="15%" y2="25%"/>
          <line class="particle-connect-1b" x1="10%" y1="20%" x2="35%" y2="45%"/>
          <line class="particle-connect-1c" x1="10%" y1="20%" x2="25%" y2="75%"/>
          
          <!-- Particle 2 connections -->
          <line class="particle-connect-2a" x1="80%" y1="60%" x2="85%" y2="65%"/>
          <line class="particle-connect-2b" x1="80%" y1="60%" x2="75%" y2="25%"/>
          <line class="particle-connect-2c" x1="80%" y1="60%" x2="65%" y2="35%"/>
          
          <!-- Particle 3 connections -->
          <line class="particle-connect-3a" x1="30%" y1="40%" x2="35%" y2="45%"/>
          <line class="particle-connect-3b" x1="30%" y1="40%" x2="15%" y2="25%"/>
          <line class="particle-connect-3c" x1="30%" y1="40%" x2="65%" y2="35%"/>
          
          <!-- Particle 4 connections -->
          <line class="particle-connect-4a" x1="70%" y1="80%" x2="45%" y2="85%"/>
          <line class="particle-connect-4b" x1="70%" y1="80%" x2="85%" y2="65%"/>
          <line class="particle-connect-4c" x1="70%" y1="80%" x2="25%" y2="75%"/>
          
          <!-- Particle 5 connections -->
          <line class="particle-connect-5a" x1="90%" y1="30%" x2="90%" y2="15%"/>
          <line class="particle-connect-5b" x1="90%" y1="30%" x2="75%" y2="25%"/>
          <line class="particle-connect-5c" x1="90%" y1="30%" x2="85%" y2="65%"/>
        </g>
      </svg>
      
      <!-- Floating Particles -->
      <div class="absolute inset-0">
        <div class="particle particle-1"></div>
        <div class="particle particle-2"></div>
        <div class="particle particle-3"></div>
        <div class="particle particle-4"></div>
        <div class="particle particle-5"></div>
        <div class="particle particle-6"></div>
        <div class="particle particle-7"></div>
        <div class="particle particle-8"></div>
        <div class="particle particle-9"></div>
        <div class="particle particle-10"></div>
        <div class="particle particle-11"></div>
        <div class="particle particle-12"></div>
        <div class="particle particle-13"></div>
        <div class="particle particle-14"></div>
        <div class="particle particle-15"></div>
        <div class="particle particle-16"></div>
        <div class="particle particle-17"></div>
        <div class="particle particle-18"></div>
        <div class="particle particle-19"></div>
        <div class="particle particle-20"></div>
        <div class="particle particle-21"></div>
      </div>
    </div>
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
            I am a <span id="typing-text" class="text-accent-400"></span><span id="cursor" class="text-accent-400">|</span>
          </h1>
          <p class="text-xl text-slate-300 mb-8">
            Passionate about anime, gaming, tech exploration, and eSports. Always experimenting with 
            different operating systems and diving deep into cybersecurity.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="#featured-projects" class="bg-accent-600 hover:bg-accent-700 text-white px-6 py-3 rounded-md font-medium transition">
              View Projects
            </a>
            <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="bg-slate-700 hover:bg-slate-600 text-white px-6 py-3 rounded-md font-medium transition">
              Resume
            </a>
            <a href="/about" class="bg-transparent hover:bg-slate-800 text-slate-300 border border-slate-700 px-6 py-3 rounded-md font-medium transition">
              About Me
            </a>
          </div>
        </div>
        
        <!-- Social Links -->
        <div class="flex flex-col items-center lg:items-end space-y-6">
          <div class="text-center lg:text-right">
            <div class="grid grid-cols-2 gap-4 max-w-lg">
              <!-- GitHub -->
              <a href="https://github.com/ExpertSunny" target="_blank" rel="noopener noreferrer" 
                 class="group relative bg-gradient-to-r from-slate-800/50 to-slate-700/50 backdrop-blur-sm border border-slate-700/50 hover:border-slate-500/70 rounded-xl p-4 transition-all duration-300 hover:bg-gradient-to-r hover:from-slate-700/60 hover:to-slate-600/60 hover:shadow-2xl hover:shadow-slate-500/20 hover:-translate-y-1 transform">
                <div class="absolute inset-0 bg-gradient-to-r from-slate-600/10 to-slate-500/10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-slate-600/30 to-slate-700/30 group-hover:from-slate-500/40 group-hover:to-slate-600/40 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300 group-hover:text-white transition-colors duration-300">
                      <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                    </svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-slate-200 group-hover:text-white transition-colors duration-300">GitHub</span>
                  </div>
                </div>
              </a>
              
              <!-- LinkedIn -->
              <a href="https://in.linkedin.com/in/preetish-chandra" target="_blank" rel="noopener noreferrer" 
                 class="group relative bg-gradient-to-r from-slate-800/50 to-slate-700/50 backdrop-blur-sm border border-slate-700/50 hover:border-blue-500/70 rounded-xl p-4 transition-all duration-300 hover:bg-gradient-to-r hover:from-blue-900/20 hover:to-blue-800/20 hover:shadow-2xl hover:shadow-blue-500/20 hover:-translate-y-1 transform">
                <div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 to-blue-500/10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-600/30 to-blue-700/30 group-hover:from-blue-500/40 group-hover:to-blue-600/40 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-300 group-hover:text-blue-200 transition-colors duration-300">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                      <rect x="2" y="9" width="4" height="12"></rect>
                      <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-slate-200 group-hover:text-white transition-colors duration-300">LinkedIn</span>
                  </div>
                </div>
              </a>
              
              <!-- Twitter/X -->
              <a href="https://x.com/ExpertSunny_IN" target="_blank" rel="noopener noreferrer" 
                 class="group relative bg-gradient-to-r from-slate-800/50 to-slate-700/50 backdrop-blur-sm border border-slate-700/50 hover:border-sky-500/70 rounded-xl p-4 transition-all duration-300 hover:bg-gradient-to-r hover:from-sky-900/20 hover:to-sky-800/20 hover:shadow-2xl hover:shadow-sky-500/20 hover:-translate-y-1 transform">
                <div class="absolute inset-0 bg-gradient-to-r from-sky-600/10 to-sky-500/10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-sky-600/30 to-sky-700/30 group-hover:from-sky-500/40 group-hover:to-sky-600/40 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky-300 group-hover:text-sky-200 transition-colors duration-300">
                      <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
                    </svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-slate-200 group-hover:text-white transition-colors duration-300">Twitter</span>
                  </div>
                </div>
              </a>
              
              <!-- Discord -->
              <a href="https://discord.gamera.co.in" target="_blank" rel="noopener noreferrer" 
                 class="group relative bg-gradient-to-r from-slate-800/50 to-slate-700/50 backdrop-blur-sm border border-slate-700/50 hover:border-indigo-500/70 rounded-xl p-4 transition-all duration-300 hover:bg-gradient-to-r hover:from-indigo-900/20 hover:to-indigo-800/20 hover:shadow-2xl hover:shadow-indigo-500/20 hover:-translate-y-1 transform">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-600/10 to-indigo-500/10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative flex items-center gap-4">
                  <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-indigo-600/30 to-indigo-700/30 group-hover:from-indigo-500/40 group-hover:to-indigo-600/40 rounded-xl flex items-center justify-center transition-all duration-300 group-hover:scale-110">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-indigo-300 group-hover:text-indigo-200 transition-colors duration-300">
                      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.191.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                    </svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-slate-200 group-hover:text-white transition-colors duration-300">Discord</span>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise Section -->
  <section class="py-16 bg-slate-950/50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold mb-12 text-center">Areas of Expertise</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 hover:border-accent-600 transition">
          <div class="text-accent-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Penetration Testing</h3>
          <p class="text-slate-300">
            Rigorous assessment of web applications, mobile apps, networks, and cloud infrastructure for security flaws.
          </p>
        </div>
        
        <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 hover:border-accent-600 transition">
          <div class="text-accent-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Home Server DevOps</h3>
          <p class="text-slate-300">
            Building and managing home lab infrastructure with Docker, Kubernetes, and various self-hosted services.
          </p>
        </div>
        
        <div class="bg-slate-800/50 p-6 rounded-lg border border-slate-700 hover:border-accent-600 transition">
          <div class="text-accent-400 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-2">Flutter App Development</h3>
          <p class="text-slate-300">
            Creating cross-platform mobile applications with Flutter, focusing on clean architecture and user experience.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section id="featured-projects" class="py-16">
    <div class="container mx-auto px-4">
      <div class="mb-12">
        <h2 class="text-3xl font-bold">Featured Projects</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Project 1 -->
        <div class="bg-slate-800/30 rounded-lg overflow-hidden border border-slate-800 hover:border-accent-600 transition">
          <div class="h-48 bg-slate-700 relative overflow-hidden">
            <img src="/minecraft.png" alt="Minecraft Server Project" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span class="text-xs bg-green-900/60 text-green-300 px-2 py-1 rounded">Gaming</span>
              <span class="text-xs bg-slate-700/60 text-slate-300 px-2 py-1 rounded">Infrastructure</span>
              <span class="text-xs bg-blue-900/60 text-blue-300 px-2 py-1 rounded">Networking</span>
            </div>
            <h3 class="text-xl font-bold mb-2">Minecraft Server with SSH Tunneling</h3>
            <p class="text-slate-300 mb-4">
              Built and deployed a public Minecraft server on my homelab using SSH tunneling and Cloudflare DNS. Features custom subdomain at minecraft.gamera.co.in with secure VPS integration.
            </p>
            <a href="https://minecraft.gamera.co.in" target="_blank" rel="noopener noreferrer" class="text-accent-400 hover:text-accent-300 transition flex items-center gap-1 text-sm">
              Visit Website 
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          </div>
        </div>
        
        <!-- Project 2 -->
        <div class="bg-slate-800/30 rounded-lg overflow-hidden border border-slate-800 hover:border-accent-600 transition">
          <div class="h-48 bg-slate-700 relative overflow-hidden">
            <img src="/gamera_ss.png" alt="Gamera Gaming Network App" class="w-full h-full object-cover" />
          </div>
          <div class="p-6">
            <div class="flex gap-2 mb-3">
              <span class="text-xs bg-green-900/60 text-green-300 px-2 py-1 rounded">Android</span>
              <span class="text-xs bg-purple-900/60 text-purple-300 px-2 py-1 rounded">Gaming</span>
            </div>
            <h3 class="text-xl font-bold mb-2">Gamera - Gaming Network App</h3>
            <p class="text-slate-300 mb-4">
              Currently developing an Android application that creates a social network platform for gamers. Will be available on Google Play Store and hosted at gamera.co.in/gamera-id.
            </p>
            <a href="https://gamera.co.in/gamera-id" target="_blank" rel="noopener noreferrer" class="text-accent-400 hover:text-accent-300 transition flex items-center gap-1 text-sm">
              Coming Soon
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  #cursor {
    animation: blink 1s infinite;
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Mesh Background Animations */
  .mesh-line-1 { animation: meshFloat1 8s ease-in-out infinite; }
  .mesh-line-2 { animation: meshFloat2 10s ease-in-out infinite; }
  .mesh-line-3 { animation: meshFloat3 12s ease-in-out infinite; }
  .mesh-line-4 { animation: meshFloat4 9s ease-in-out infinite; }
  .mesh-line-5 { animation: meshFloat5 11s ease-in-out infinite; }
  .mesh-line-6 { animation: meshFloat6 7s ease-in-out infinite; }

  .mesh-node-1 { animation: nodeFloat1 6s ease-in-out infinite; }
  .mesh-node-2 { animation: nodeFloat2 8s ease-in-out infinite; }
  .mesh-node-3 { animation: nodeFloat3 7s ease-in-out infinite; }
  .mesh-node-4 { animation: nodeFloat4 9s ease-in-out infinite; }
  .mesh-node-5 { animation: nodeFloat5 10s ease-in-out infinite; }
  .mesh-node-6 { animation: nodeFloat6 5s ease-in-out infinite; }
  .mesh-node-7 { animation: nodeFloat7 8s ease-in-out infinite; }
  .mesh-node-8 { animation: nodeFloat8 6s ease-in-out infinite; }

  .mesh-connect-1 { animation: connectMove1 8s ease-in-out infinite; }
  .mesh-connect-2 { animation: connectMove2 10s ease-in-out infinite; }
  .mesh-connect-3 { animation: connectMove3 12s ease-in-out infinite; }
  .mesh-connect-4 { animation: connectMove4 9s ease-in-out infinite; }
  .mesh-connect-5 { animation: connectMove5 11s ease-in-out infinite; }
  .mesh-connect-6 { animation: connectMove6 7s ease-in-out infinite; }
  .mesh-connect-7 { animation: connectMove7 13s ease-in-out infinite; }
  .mesh-connect-8 { animation: connectMove8 6s ease-in-out infinite; }
  .mesh-connect-9 { animation: connectMove9 14s ease-in-out infinite; }
  .mesh-connect-10 { animation: connectMove10 8.5s ease-in-out infinite; }
  .mesh-connect-11 { animation: connectMove11 9.5s ease-in-out infinite; }
  .mesh-connect-12 { animation: connectMove12 15s ease-in-out infinite; }

  /* Particle Connection Animations */
  .particle-connect-1a { animation: particleConnection1a 15s ease-in-out infinite; }
  .particle-connect-1b { animation: particleConnection1b 15s ease-in-out infinite; }
  .particle-connect-1c { animation: particleConnection1c 15s ease-in-out infinite; }
  
  .particle-connect-2a { animation: particleConnection2a 20s ease-in-out infinite; }
  .particle-connect-2b { animation: particleConnection2b 20s ease-in-out infinite; }
  .particle-connect-2c { animation: particleConnection2c 20s ease-in-out infinite; }
  
  .particle-connect-3a { animation: particleConnection3a 18s ease-in-out infinite; }
  .particle-connect-3b { animation: particleConnection3b 18s ease-in-out infinite; }
  .particle-connect-3c { animation: particleConnection3c 18s ease-in-out infinite; }
  
  .particle-connect-4a { animation: particleConnection4a 12s ease-in-out infinite; }
  .particle-connect-4b { animation: particleConnection4b 12s ease-in-out infinite; }
  .particle-connect-4c { animation: particleConnection4c 12s ease-in-out infinite; }
  
  .particle-connect-5a { animation: particleConnection5a 25s ease-in-out infinite; }
  .particle-connect-5b { animation: particleConnection5b 25s ease-in-out infinite; }
  .particle-connect-5c { animation: particleConnection5c 25s ease-in-out infinite; }

  .particle {
    position: absolute;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.8) 0%, rgba(59, 130, 246, 0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .particle-1 {
    width: 4px;
    height: 4px;
